{
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cleanup-inactive-parties",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/send-final-list",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/venue.html",
      "has": [{ "type": "query", "key": "venue", "value": "(?<slug>.+)" }],
      "destination": "/venue/:slug/",
      "permanent": true
    }
  ]
}
